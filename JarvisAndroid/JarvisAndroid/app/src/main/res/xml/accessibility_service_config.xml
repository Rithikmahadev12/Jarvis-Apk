<?xml version="1.0" encoding="utf-8"?>
<!--
  res/xml/accessibility_service_config.xml
  Drop this file at:
    app/src/main/res/xml/accessibility_service_config.xml

  Tells Android what events PhoneControlService needs to receive.
  - accessibilityEventTypes: window changes + content changes so we know
    when a new screen has painted and elements are available to tap.
  - accessibilityFlags: retrieve interactive windows (so we can read
    elements across all layers, not just the topmost) + enhanced web
    accessibility (Chrome/WebView support).
  - canRetrieveWindowContent: true — required to read the UI node tree.
  - canPerformGestures: true — required for swipe + tap-by-coords gestures.
  - settingsActivity: points to MainActivity so the user can reach settings
    from the Accessibility panel.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRequestEnhancedWebAccessibility|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.jarvis.assist.ui.MainActivity" />
