<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ══ SCREEN 1: URL SETUP (first ever launch only) ═════════════ -->
        <LinearLayout
            android:id="@+id/layout_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:letterSpacing="0.25"
                android:layout_marginTop="64dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect once. Stay connected."
                android:textColor="#66FFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="56dp" />

            <EditText
                android:id="@+id/et_jarvis_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Jarvis URL"
                android:inputType="textUri"
                android:textColor="#FFFFFF"
                android:textColorHint="#55FFFFFF"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tv_url_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF6B6B"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_connect_url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Connect"
                android:textColor="#000000"
                android:backgroundTint="#FFFFFF"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- ══ SCREEN 2: ACCOUNT PICKER ════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layout_account_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:letterSpacing="0.25"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Who are you?"
                android:textColor="#66FFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="40dp" />

            <!-- Accounts load here dynamically -->
            <LinearLayout
                android:id="@+id/layout_accounts_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF"
                android:layout_marginBottom="20dp" />

            <!-- Manual name fallback -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Or enter your name manually:"
                android:textColor="#55FFFFFF"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/et_manual_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Your name"
                android:inputType="textPersonName"
                android:textColor="#FFFFFF"
                android:textColorHint="#44FFFFFF"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_picker_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF6B6B"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_sign_in_manual"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Sign In"
                android:textColor="#000000"
                android:backgroundTint="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_change_url"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="← Change Server URL"
                android:textColor="#55FFFFFF"
                android:backgroundTint="#0D0D0D"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- ══ SCREEN 3: DASHBOARD ══════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layout_dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:letterSpacing="0.25"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● ONLINE"
                android:textColor="#44FF88"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="32dp" />

            <TextView
                android:id="@+id/tv_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_connected_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#55FFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_session_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#33FFFFFF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_memory_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#44FF88"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginBottom="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hold the home button to talk to Jarvis."
                android:textColor="#88FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btn_test_voice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Test Voice Now"
                android:textColor="#000000"
                android:backgroundTint="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_switch_account"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Switch Account"
                android:textColor="#AAAAAA"
                android:backgroundTint="#1A1A1A"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_reset_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Reset Everything"
                android:textColor="#FF6B6B"
                android:backgroundTint="#1A1A1A"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>
</ScrollView>
