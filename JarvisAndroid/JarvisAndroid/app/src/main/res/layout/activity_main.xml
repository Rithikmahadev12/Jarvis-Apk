<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ══ SETUP SCREEN ══════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layout_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:letterSpacing="0.25"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect once. Stay connected."
                android:textColor="#66FFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="48dp" />

            <EditText
                android:id="@+id/et_jarvis_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Jarvis URL (e.g. https://mcujarvis.onrender.com)"
                android:inputType="textUri"
                android:textColor="#FFFFFF"
                android:textColorHint="#55FFFFFF"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/et_user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Your name (default: Sir)"
                android:inputType="textPersonName"
                android:textColor="#FFFFFF"
                android:textColorHint="#55FFFFFF"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/et_user_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Your title (default: Sir)"
                android:inputType="textPersonName"
                android:textColor="#FFFFFF"
                android:textColorHint="#55FFFFFF"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF6B6B"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Save &amp; Connect"
                android:textColor="#000000"
                android:backgroundTint="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- ══ DASHBOARD SCREEN ══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layout_dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:letterSpacing="0.25"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● ONLINE"
                android:textColor="#44FF88"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="48dp" />

            <TextView
                android:id="@+id/tv_connected_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_session_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#44FFFFFF"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hold the home button to talk to Jarvis."
                android:textColor="#88FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btn_test_voice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Test Voice Now"
                android:textColor="#000000"
                android:backgroundTint="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_reset_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Reset / Change URL"
                android:textColor="#FF6B6B"
                android:backgroundTint="#1A1A1A"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>
</ScrollView>
