<?xml version="1.0" encoding="utf-8"?>
<!--
    Jarvis Voice Overlay — bottom sheet style, exactly like Google Assistant.
    Sits at the bottom of the screen, transparent above it, rounded top corners.
    Swipe down or tap outside to dismiss.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Dim scrim — tapping it dismisses the overlay -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true" />

    <!-- Bottom sheet card -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/sheet_bg"
        android:paddingTop="12dp"
        android:paddingBottom="32dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:elevation="16dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="#55FFFFFF"
            android:backgroundTint="#55FFFFFF" />

        <!-- Top row: Jarvis label + close button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="JARVIS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:letterSpacing="0.2" />

            <TextView
                android:id="@+id/btn_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#66FFFFFF"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Pulse ring + mic icon row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Animated mic orb -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="16dp">

                <View
                    android:id="@+id/pulse_ring"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/circle_pulse"
                    android:alpha="0.0" />

                <ImageView
                    android:id="@+id/iv_jarvis_icon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_jarvis"
                    android:contentDescription="Jarvis"
                    android:scaleType="centerInside"
                    android:padding="10dp" />

            </FrameLayout>

            <!-- Status + user speech text -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listening…"
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_user_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:lineSpacingMultiplier="1.3"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>

        <!-- Divider — only visible after user speaks -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <!-- Jarvis reply (typewriter reveal) -->
        <TextView
            android:id="@+id/tv_jarvis_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#EEFFFFFF"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.5"
            android:maxLines="6"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
