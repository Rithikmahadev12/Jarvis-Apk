<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0000000"
    android:fitsSystemWindows="false">

    <!-- Pulse ring behind icon -->
    <View
        android:id="@+id/pulse_ring"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center"
        android:layout_marginBottom="120dp"
        android:background="@drawable/circle_pulse"
        android:alpha="0.0"
        android:visibility="invisible" />

    <!-- Close button (top-right corner) -->
    <TextView
        android:id="@+id/btn_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:gravity="center"
        android:text="✕"
        android:textColor="#99FFFFFF"
        android:textSize="20sp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Center column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Jarvis icon / mic indicator -->
        <ImageView
            android:id="@+id/iv_jarvis_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_jarvis"
            android:contentDescription="Jarvis"
            android:layout_marginBottom="8dp" />

        <!-- Status label (Listening… / Thinking… / Jarvis) -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initializing…"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="24dp" />

        <!-- What the user said -->
        <TextView
            android:id="@+id/tv_user_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="18sp"
            android:lineSpacingMultiplier="1.35"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <!-- Divider -->
        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:background="#44FFFFFF"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            android:id="@+id/divider" />

        <!-- Jarvis reply (typewriter reveal) -->
        <TextView
            android:id="@+id/tv_jarvis_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.5"
            android:gravity="center"
            android:visibility="gone"
            android:maxLines="12"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Swipe-down hint -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="swipe down to dismiss"
        android:textColor="#44FFFFFF"
        android:textSize="11sp" />

</FrameLayout>
