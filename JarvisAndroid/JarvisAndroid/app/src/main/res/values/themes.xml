<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme — dark, no action bar -->
    <style name="Theme.JarvisAssist" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorPrimaryVariant">#CCCCCC</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSurface">#0D0D0D</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:windowBackground">#0D0D0D</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
    </style>

    <!--
        Overlay theme — translucent window so only the bottom sheet shows.
        backgroundDimEnabled false because we draw our own scrim view.
        windowIsFloating false so it fills the screen width at the bottom.
    -->
    <style name="Theme.JarvisOverlay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/OverlayAnim</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
    </style>

    <!-- Slide up / slide down animation for the overlay -->
    <style name="OverlayAnim">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>
</resources>
