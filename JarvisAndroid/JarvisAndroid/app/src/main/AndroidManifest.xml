<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — JARVIS aOS Edition
  Target device: Motorola XT2271DL (Moto G Pure, Android 11, API 30)
  New in this revision:
    • JarvisLauncherActivity — HOME launcher entry point (matches OSO launcher capability)
    • VaultLockActivity — secure gate before dashboard (unchanged)
    • JarvisWallpaperService — live wallpaper like OSO radar background
    • JarvisAdminReceiver — device admin (force-lock, matches OSO oso_admin.xml)
    • HOME category on launcher so it replaces default launcher on XT2271DL
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Core Permissions ── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Device admin — required for force-lock like OSO -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />
    <!-- Launcher shortcut pinning -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_jarvis"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_jarvis"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisAssist"
        android:usesCleartextTraffic="false">

        <!-- ══════════════════════════════════════════════════════════════════
             LAUNCHER ACTIVITY — HOME category (replaces system launcher)
             Matches OSO AugmaOS: responds to android.intent.category.HOME
             Users set Jarvis as default launcher from Settings > Apps > Default Apps
             On XT2271DL / Moto G Pure this becomes the full home screen.
             ══════════════════════════════════════════════════════════════════ -->
        <activity
            android:name=".ui.JarvisLauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisLauncher"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY" />
            </intent-filter>
        </activity>

        <!-- ══════════════════════════════════════════════════════════════════
             VAULT LOCK — secure gate (unchanged from prior version)
             Users who deep-link or return from background hit vault first.
             ══════════════════════════════════════════════════════════════════ -->
        <activity
            android:name=".ui.VaultLockActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisAssist"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── HOME HUD — Iron Man portal home screen ── -->
        <activity
            android:name=".ui.HomeHudActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.JarvisAssist"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- ── LANDSCAPE HUD ── -->
        <activity
            android:name=".ui.LandscapeHudActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.JarvisAssist"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- ── MAIN DASHBOARD (after vault) ── -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisAssist"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── VOICE OVERLAY ── -->
        <activity
            android:name=".ui.VoiceOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisOverlay"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- ── JARVIS ASSIST SERVICE ── -->
        <service
            android:name=".JarvisAssistService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ── BOOT RECEIVER ── -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ══════════════════════════════════════════════════════════════════
             DEVICE ADMIN RECEIVER — matches OSO oso_admin.xml (force-lock)
             Required to call DevicePolicyManager.lockNow() for vault auto-lock
             ══════════════════════════════════════════════════════════════════ -->
        <receiver
            android:name=".JarvisAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/jarvis_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- ══════════════════════════════════════════════════════════════════
             LIVE WALLPAPER SERVICE — matches OSO oso_wallpaper.xml
             JarvisWallpaperService draws the radar/HUD animation as wallpaper
             ══════════════════════════════════════════════════════════════════ -->
        <service
            android:name=".ui.JarvisWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER"
            android:label="@string/jarvis_wallpaper_label">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/jarvis_wallpaper" />
        </service>

        <!-- ══════════════════════════════════════════════════════════════════
             SESSION SERVICE
             ══════════════════════════════════════════════════════════════════ -->
        <service
            android:name=".JarvisSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
