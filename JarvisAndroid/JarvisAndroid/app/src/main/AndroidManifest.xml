<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — JARVIS App Edition (not a launcher)
  Target: Motorola XT2271DL (Moto G Pure, Android 11, API 30)
  Removed vs prior version: HOME category, wallpaper service, device admin receiver
  VaultLockActivity remains the LAUNCHER entry point (opens from app drawer normally)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_jarvis"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_jarvis"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisAssist"
        android:usesCleartextTraffic="false">

        <!-- VAULT LOCK — launcher entry point (opens from app drawer, not HOME) -->
        <activity
            android:name=".ui.VaultLockActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisAssist"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HOME HUD — OSO-aesthetic radar dial, reached after vault unlock -->
        <activity
            android:name=".ui.HomeHudActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.JarvisAssist"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- LANDSCAPE HUD -->
        <activity
            android:name=".ui.LandscapeHudActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.JarvisAssist"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- MAIN DASHBOARD -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisAssist"
            android:windowSoftInputMode="adjustResize" />

        <!-- VOICE OVERLAY -->
        <activity
            android:name=".ui.VoiceOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisOverlay"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- JARVIS ACCESSIBILITY SERVICE -->
        <service
            android:name=".JarvisAssistService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- BOOT RECEIVER -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- SESSION SERVICE -->
        <service
            android:name=".JarvisSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
