<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — FULL REPLACEMENT
  NEW: VaultLockActivity is now the LAUNCHER entry point.
       MainActivity is only reachable after vault unlock.
       LandscapeHudActivity added for HUD mode.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_jarvis"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_jarvis"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisAssist"
        android:usesCleartextTraffic="false">

        <!--
            ╔══════════════════════════════════════════════════════════════╗
            ║  VAULT LOCK — this is the new LAUNCHER entry point          ║
            ║  User MUST enter pattern before reaching the dashboard.     ║
            ║  On first launch: prompts to CREATE a pattern.              ║
            ╚══════════════════════════════════════════════════════════════╝
        -->
        <activity
            android:name=".ui.VaultLockActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisAssist"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ── MAIN DASHBOARD ──
            Only reached after vault unlock.
            NOT exported (can't be deep-linked from outside the app).
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            ── LANDSCAPE HUD MODE ──
            Triggered from dashboard tray or voice command.
            Locks to landscape + keeps screen on.
        -->
        <activity
            android:name=".ui.LandscapeHudActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisAssist"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:launchMode="singleTop" />

        <!-- ── VOICE OVERLAY ACTIVITY ── -->
        <activity
            android:name=".ui.VoiceOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisOverlay"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- ── JARVIS VOICE INTERACTION SERVICE (home-button trigger) ── -->
        <service
            android:name=".JarvisAssistService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
        </service>

        <!-- ── SESSION SERVICE ── -->
        <service
            android:name=".JarvisVoiceSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- ── JARVIS SESSION SERVICE (foreground — keeps mic warm) ── -->
        <service
            android:name=".JarvisSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- ── BOOT RECEIVER ── -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ── PHONE CONTROL — Accessibility Service ── -->
        <service
            android:name=".PhoneControlService"
            android:exported="true"
            android:label="Jarvis Phone Control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
