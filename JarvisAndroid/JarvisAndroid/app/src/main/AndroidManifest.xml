<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — FULL REPLACEMENT
  Adds PhoneControlService (Accessibility Service) to the existing manifest.
  Everything else is unchanged from the working build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_jarvis"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_jarvis"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisAssist"
        android:usesCleartextTraffic="false">

        <!-- ── MAIN SETUP ACTIVITY ── -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── VOICE OVERLAY ACTIVITY ── -->
        <activity
            android:name=".ui.VoiceOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisOverlay"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- ── JARVIS VOICE INTERACTION SERVICE (home-button trigger) ── -->
        <service
            android:name=".JarvisAssistService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
        </service>

        <!-- ── SESSION SERVICE — Android calls this to get a VoiceInteractionSession ── -->
        <service
            android:name=".JarvisVoiceSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- ── JARVIS SESSION SERVICE (foreground — keeps mic warm) ── -->
        <service
            android:name=".JarvisSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- ── BOOT RECEIVER (restart foreground service after reboot) ── -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ── PHONE CONTROL — Accessibility Service ── -->
        <!--
            This lets Jarvis navigate your phone's UI on voice command.
            After installing the APK, go to:
            Settings → Accessibility → Installed apps → Jarvis → enable "Phone Control"

            Android will warn "this app can read your screen" — that's expected.
            Jarvis only reads the UI when you give it a navigation command.
        -->
        <service
            android:name=".PhoneControlService"
            android:exported="true"
            android:label="Jarvis Phone Control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
